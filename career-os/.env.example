# Career OS — example environment. Copy to .env.local (gitignored). NEVER commit real values.

# ---------------------------------------------------------------- dashboard access
# auto: off locally (loopback only), REQUIRED on Vercel (the app answers 503 until configured)
CAREER_OS_AUTH_MODE=
# generate both with: node apps/dashboard/scripts/hash-password.mjs   (password read from stdin)
CAREER_OS_PASSWORD_HASH=
CAREER_OS_SESSION_SECRET=

# ---------------------------------------------------------------- data
# Dashboard data source: auto | demo | career-ops   (on Vercel use demo until the DB mirror is the source)
CAREER_OS_DATA_SOURCE=auto
# career-ops checkout to read (default: career-os/upstream/career-ops)
CAREER_OPS_ROOT=
# Private local data (pipeline file, run logs, profile-extension.yml) — gitignored
CAREER_OS_PRIVATE_DIR=

# ---------------------------------------------------------------- persistence
# auto | file | postgres | none   (auto: postgres if DATABASE_URL+OWNER set, else file locally, none on Vercel)
CAREER_OS_STORE=auto
# Supabase transaction pooler URL (port 6543), with ?sslmode=require. Server-side only.
DATABASE_URL=
# UUID of your user in Supabase Auth (Authentication → Users)
CAREER_OS_OWNER_ID=
# PEM of the project CA (Database Settings → SSL Configuration → Download certificate).
# Required for *.supabase.com/.co hosts: TLS with chain + hostname verification.
SUPABASE_CA_CERT=

# ---------------------------------------------------------------- optional tools
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Future (not implemented) — do not fill
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
