# Career OS — example environment. Copy to .env (gitignored). Never commit real values.
# All are OPTIONAL in Phase 1: the core runs locally with no keys.

# AI providers (only if you choose the standalone evaluators; Claude Code subscription needs none)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Browser for PDFs / liveness checks when Playwright's bundled Chromium is unavailable
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# Location of private data outside git (future: Phase 2+)
CAREER_OS_PRIVATE_DIR=./private

# Future (Phase 5/6) — do not fill until the integration is approved
DATABASE_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DASHBOARD_AUTH_SECRET=
